# Copy the values below into /opt/gridwords-bot/runtime.env. Replace every placeholder
# on the server; this example contains no production data or secrets.
POSTGRES_DB=gridwords
POSTGRES_USER=gridwords
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
DATABASE_URL=jdbc:postgresql://postgres:5432/gridwords
DATABASE_USERNAME=gridwords
DATABASE_PASSWORD=replace-with-the-same-long-random-postgres-password

DISCORD_ENABLED=true
DISCORD_BOT_TOKEN=replace-with-the-production-discord-token
DISCORD_GUILD_ID=replace-with-production-guild-id
DISCORD_CHANNEL_ID=replace-with-production-channel-id
ADMIN_USER_IDS=replace-with-production-admin-user-id

REMINDER_FIRST_TIME=16:00
REMINDER_SECOND_TIME=22:00
DAILY_CLEANUP_TIME=06:00
WEEKLY_REPORT_TIME=08:00
MONTHLY_REPORT_TIME=08:15
TIME_ZONE=Europe/Berlin
RAW_IMAGE_RETENTION_HOURS=48

# Keep false until the feature has been accepted and the production rollout is intentional.
EXCUSE_GENERATOR_CONTEXTUAL_ENABLED=false
EXCUSE_OFFER_LIFETIME=PT15M
EXCUSE_EXPIRATION_PAGE_SIZE=25
EXCUSE_EXPIRATION_MAX_PAGES=4

# Persistent record live evaluation. Keep the defaults unless production evidence justifies tuning.
RECORD_LIVE_EVALUATION_ENABLED=true
RECORD_LIVE_EVALUATION_POLL_DELAY=PT10S
RECORD_LIVE_EVALUATION_LEASE_DURATION=PT2M
RECORD_LIVE_EVALUATION_HEARTBEAT_INTERVAL=PT30S
RECORD_LIVE_EVALUATION_INITIAL_RETRY_BACKOFF=PT10S
RECORD_LIVE_EVALUATION_MAX_RETRY_BACKOFF=PT5M